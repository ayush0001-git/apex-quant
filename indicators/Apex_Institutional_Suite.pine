//@version=5
indicator("Apex Institutional Suite [NSE / BSE Quant Terminal]", shorttitle="APEX PRO", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ==========================================
// 1. INPUT SETTINGS & CONFIGURATION
// ==========================================
grp_trend = "Trend & Ribbon Settings"
show_ema20 = input.bool(true, "Show EMA 20 (Fast Momentum)", group=grp_trend)
show_ema50 = input.bool(true, "Show EMA 50 (Structural Support)", group=grp_trend)
show_ema200 = input.bool(true, "Show EMA 200 (Macro Regime)", group=grp_trend)
show_ribbon = input.bool(true, "Show Dynamic Ribbon Cloud", group=grp_trend)

grp_super = "SuperTrend & ATR Bands"
show_supertrend = input.bool(true, "Show SuperTrend", group=grp_super)
atr_period = input.int(14, "ATR Period", group=grp_super)
super_mult = input.float(2.0, "SuperTrend Factor", step=0.1, group=grp_super)
show_atr_tolerance = input.bool(true, "Show ATR Tolerance Bands (0.25 * ATR)", group=grp_super)

grp_kronos = "Kronos Probabilistic Ghost Bands"
show_kronos = input.bool(true, "Show Kronos Predictive Range Cone", group=grp_kronos)
kronos_bars = input.int(12, "Forecast Horizon (Bars Forward)", minval=5, maxval=30, group=grp_kronos)
kronos_drift = input.float(1.5, "Drift Expansion Multiplier", step=0.1, group=grp_kronos)

grp_patterns = "Candlestick Patterns (Strict Non-Repainting)"
show_bull_patterns = input.bool(true, "Show Bullish Reversal Signals", group=grp_patterns)
show_bear_patterns = input.bool(true, "Show Bearish Reversal Signals", group=grp_patterns)

grp_risk = "SEBI Statutory Friction & Risk Gate HUD"
show_hud = input.bool(true, "Display Live Quantitative HUD Table", group=grp_risk)
portfolio_equity = input.float(100000.0, "Portfolio Capital (INR)", group=grp_risk)
max_risk_pct = input.float(1.0, "Max Capital Risk % Per Trade", step=0.1, group=grp_risk)
min_friction_mult = input.float(3.5, "SEBI Friction Hurdle Multiplier (> 3.5x)", step=0.5, group=grp_risk)

// ==========================================
// 2. MATHEMATICAL CORE INDICATORS
// ==========================================
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr = ta.atr(atr_period)

// SuperTrend Calculation
[st_line, st_dir] = ta.supertrend(super_mult, atr_period)

// Plot EMAs
p_ema20 = plot(show_ema20 ? ema20 : na, title="EMA 20", color=color.new(#06b6d4, 0), linewidth=2)
p_ema50 = plot(show_ema50 ? ema50 : na, title="EMA 50", color=color.new(#f59e0b, 0), linewidth=2)
plot(show_ema200 ? ema200 : na, title="EMA 200", color=color.new(#e2e8f0, 20), linewidth=3)

// Ribbon Cloud
ribbon_color = ema20 >= ema50 ? color.new(#10b981, 80) : color.new(#f43f5e, 80)
fill(p_ema20, p_ema50, color=show_ribbon ? ribbon_color : na, title="EMA Ribbon Cloud")

// SuperTrend Plot
plot(show_supertrend ? st_line : na, title="SuperTrend", color=st_dir == 1 ? #10b981 : #f43f5e, linewidth=2, style=plot.style_linebr)

// ATR Tolerance Bands (0.25 * ATR)
tolerance = 0.25 * atr
plot(show_atr_tolerance ? close + tolerance : na, title="Upper ATR Tolerance", color=color.new(#06b6d4, 75), style=plot.style_circles)
plot(show_atr_tolerance ? close - tolerance : na, title="Lower ATR Tolerance", color=color.new(#06b6d4, 75), style=plot.style_circles)

// ==========================================
// 3. CANDLESTICK PATTERN RECOGNITION (NON-REPAINTING)
// ==========================================
body = math.abs(close - open)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low
is_bull = close > open
is_bear = close < open

// Non-repainting: Only triggers when candle is confirmed
confirmed = barstate.isconfirmed

// Hammer Pattern
is_hammer = lower_wick >= 2.0 * body and upper_wick <= 0.2 * body and is_bull
plotshape(confirmed and show_bull_patterns and is_hammer, title="Hammer", location=location.belowbar, color=#10b981, style=shape.triangleup, text="HAMMER", size=size.small)

// Bullish Engulfing
is_bull_engulfing = is_bull and is_bear[1] and close >= open[1] and open <= close[1] and body > body[1]
plotshape(confirmed and show_bull_patterns and is_bull_engulfing, title="Bullish Engulfing", location=location.belowbar, color=#10b981, style=shape.labelup, text="BULL ENGULF", textcolor=color.black, size=size.small)

// Shooting Star
is_shooting_star = upper_wick >= 2.0 * body and lower_wick <= 0.2 * body and is_bear
plotshape(confirmed and show_bear_patterns and is_shooting_star, title="Shooting Star", location=location.abovebar, color=#f43f5e, style=shape.triangledown, text="STAR", size=size.small)

// Bearish Engulfing
is_bear_engulfing = is_bear and is_bull[1] and open >= close[1] and close <= open[1] and body > body[1]
plotshape(confirmed and show_bear_patterns and is_bear_engulfing, title="Bearish Engulfing", location=location.abovebar, color=#f43f5e, style=shape.labeldown, text="BEAR ENGULF", textcolor=color.white, size=size.small)

// ==========================================
// 4. KRONOS GHOST PROJECTION CONE (FUTURE BARS)
// ==========================================
var line ghost_upper = na
var line ghost_lower = na
var line ghost_mid = na
var box ghost_box = na

if barstate.islast and show_kronos
    line.delete(ghost_upper)
    line.delete(ghost_lower)
    line.delete(ghost_mid)
    box.delete(ghost_box)

    future_x = bar_index + kronos_bars
    drift_high = close + (kronos_drift * atr * math.sqrt(kronos_bars))
    drift_low = close - (kronos_drift * atr * math.sqrt(kronos_bars))

    ghost_upper := line.new(bar_index, close, future_x, drift_high, color=#8b5cf6, width=2, style=line.style_dashed)
    ghost_lower := line.new(bar_index, close, future_x, drift_low, color=#8b5cf6, width=2, style=line.style_dashed)
    ghost_mid := line.new(bar_index, close, future_x, (drift_high + drift_low) / 2, color=color.new(#06b6d4, 50), width=1, style=line.style_dotted)
    ghost_box := box.new(bar_index, drift_high, future_x, drift_low, border_color=color.new(#8b5cf6, 80), bgcolor=color.new(#8b5cf6, 85))

// ==========================================
// 5. STATUTORY FRICTION & SEBI RISK GATE TABLE
// ==========================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(#070a12, 10), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast and show_hud
    risk_amount = portfolio_equity * (max_risk_pct / 100.0)
    stop_distance = 1.5 * atr
    target_distance = 3.0 * atr

    shares = stop_distance > 0 ? math.floor(risk_amount / stop_distance) : 0
    trade_value = shares * close

    // Statutory Charges (Indian Equity Delivery/Intraday)
    brokerage = math.min(40.0, trade_value * 0.001) // ₹20 each side
    stt = trade_value * 0.00125 // STT both sides average
    turnover_fee = trade_value * 0.0000325 * 2
    gst = (brokerage + turnover_fee) * 0.18
    stamp_duty = trade_value * 0.00015
    slippage = trade_value * 0.0005 * 2
    total_friction = brokerage + stt + turnover_fee + gst + stamp_duty + slippage

    expected_profit = shares * target_distance
    hurdle_ratio = total_friction > 0 ? expected_profit / total_friction : 0.0
    is_approved = hurdle_ratio >= min_friction_mult and shares > 0

    // Table Rendering
    table.cell(hud, 0, 0, "APEX QUANT TERMINAL", bgcolor=color.new(#0d1322, 0), text_color=#06b6d4, text_size=size.small)
    table.cell(hud, 1, 0, "NSE / BSE PRO", bgcolor=color.new(#0d1322, 0), text_color=#f8fafc, text_size=size.small)

    table.cell(hud, 0, 1, "Spot Price / ATR", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 1, "₹" + str.tostring(close, "#.##") + " / " + str.tostring(atr, "#.##"), text_color=#f8fafc, text_size=size.tiny)

    table.cell(hud, 0, 2, "Allocated Position", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 2, str.tostring(shares) + " Shares (₹" + str.tostring(trade_value, "#") + ")", text_color=#f8fafc, text_size=size.tiny)

    table.cell(hud, 0, 3, "Stop / Target 1", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 3, "SL: ₹" + str.tostring(close - stop_distance, "#.##") + " | T1: ₹" + str.tostring(close + target_distance, "#.##"), text_color=#f8fafc, text_size=size.tiny)

    table.cell(hud, 0, 4, "Statutory Friction", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 4, "₹" + str.tostring(total_friction, "#.##") + " (STT+GST+Stamp)", text_color=#f59e0b, text_size=size.tiny)

    table.cell(hud, 0, 5, "Friction Hurdle R:R", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 5, str.tostring(hurdle_ratio, "#.##") + "x vs 3.5x Requirement", text_color=is_approved ? #10b981 : #f43f5e, text_size=size.tiny)

    table.cell(hud, 0, 6, "Risk Gate Verdict", bgcolor=is_approved ? color.new(#10b981, 20) : color.new(#f43f5e, 20), text_color=#f8fafc, text_size=size.small)
    table.cell(hud, 1, 6, is_approved ? "APPROVED" : "REJECTED", bgcolor=is_approved ? color.new(#10b981, 20) : color.new(#f43f5e, 20), text_color=is_approved ? #10b981 : #f43f5e, text_size=size.small)
